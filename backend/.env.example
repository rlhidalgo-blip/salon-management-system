DB_HOST=localhost
DB_PORT=5432
DB_NAME=yabs_salon_dev
DB_USER=yabs_app
DB_PASSWORD=replace_with_your_local_password
# For Neon direct connections, set DB_SSLMODE=verify-full in protected runtime config.
# Local PostgreSQL may leave this unset. Keep the staging SQLAlchemy pool small.
# DB_SSLMODE=verify-full
# DB_POOL_SIZE=2
# DB_MAX_OVERFLOW=0

# Default is production; use localhost only for local HTTP development.
AUTH_COOKIE_MODE=production
AUTH_ALLOWED_ORIGIN=https://replace-with-your-production-origin.example
AUTH_RATE_LIMIT_SECRET=replace_with_at_least_32_random_bytes_before_running_auth

# Set APP_ENV=production in the protected production runtime (not in local development).
# Production startup checks this configured name against the connected database.
APP_ENV=development
DB_EXPECTED_NAME=
# Keep 0 until the coordinated migration and worker cutover are complete.
SALE_ATTEMPT_PROTOCOL_ENABLED=0
